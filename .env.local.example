# Bu dosyayı `.env.local` adıyla kopyala ve değerleri doldur.
# `.env.local` .gitignore içindedir: asla depoya gitmez.
# Rastgele değerleri üretmek için:  npm run gizli

# --- Veritabanı: Neon (ZORUNLU) --------------------------------------------
# Vercel → Storage → Create Database → Neon → Free planı.
# Oluştuktan sonra store sayfasındaki connection string buraya.
# (Neon'u doğrudan neon.tech üzerinden de açabilirsin; fark etmez.)
#
# Sürücünün tip tuzakları lib/veritabani.ts başında yazılı.
#
# Bu değişken NEXT_PUBLIC_ öneki ALMAZ; yalnızca sunucu tarafında okunur ve
# tarayıcıya asla gitmez.
DATABASE_URL=

# --- Erişim koruması (ZORUNLU) --------------------------------------------
# Uygulamaya giriş parolası. Kendin belirle.
APP_PAROLA=

# Oturum çerezini imzalar. 32+ karakter, rastgele, parolandan farklı.
OTURUM_GIZLI=

# --- Yapay zekâ ile ayrıştırma (İSTEĞE BAĞLI) -----------------------------
# İkisi de boşsa uygulama tamamen çalışır; sadece "Metinden ekle" ekranı
# kapanır ve programları elle eklersin. Kural tabanlı ayrıştırıcı YOK -
# gerekçesi lib/ayristir-yz.ts başında (PROJE.md Aşama 10 iptal edildi).
#
# BİRİ YETER. İkisi de tanımlıysa /ekle ekranında hangisinin okuyacağını
# seçebilirsin; varsayılan Claude. Aynı şemayı dolduruyorlar, çıktı aynı
# süzgeçten geçiyor: biri kotayı doldurduğunda diğerine geçmek için.
#
# ÖLÜ ANAHTARI SİLMEK ZORUNDASIN. Uygulama "anahtar tanımlı mı" diye
# bakabiliyor, "anahtar çalışıyor mu" diye bakamıyor. İptal edilmiş bir
# anahtar değer olarak dururken o sağlayıcı /ekle ekranında seçenek olarak
# görünmeye devam eder ve her deneme hatayla biter. Kullanmadığın
# sağlayıcının satırını BOŞ bırak. Bir kez yaşandı (Gemini, 2026-09).
#
# Anahtar: https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=

# Anahtar: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Model adları (İSTEĞE BAĞLI) ------------------------------------------
# Boş bırakırsan varsayılanlar kullanılır. Model isimleri koddaki en çabuk
# eskiyen şey; yeni sürüm çıkınca dağıtım yapmak yerine burayı değiştir.
# ANTHROPIC_MODEL=claude-opus-5
# GEMINI_MODEL=gemini-flash-latest

# --- Burs uygulaması köprüsü (İSTEĞE BAĞLI) -------------------------------
# Bursları ayrı bir uygulamada tutuyorsan adresi buraya yaz; program detay
# sayfasına o uygulamaya giden bir bağlantı eklenir. Boşsa bağlantı hiç
# görünmez. Tarayıcıya gittiği için NEXT_PUBLIC_ öneki ŞART.
# NEXT_PUBLIC_BURS_APP_URL=
